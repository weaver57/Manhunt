# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git. Keep real secrets out of this file too
# (GitHub push protection blocks commits containing them).

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# EAS (Expo Application Services)
EAS_PROJECT_ID=<eas-project-id>

# Google OAuth (actual client IDs go in google-services.json / GoogleService-Info.plist)
GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# Android release keystore: keep fingerprints/aliases in your password manager,
# credentials files (jks, google-services.json) stay out of the repository.
